VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN sparse_top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 100000 100000 ) ;
ROW ROW_0 corecell 5000 5000 N DO 20 BY 1 STEP 5000 0 ;
COMPONENTS 2 ;
  - buf1 BUF
    + SOURCE USER
    + PLACED ( 20000 20000 ) N ;
  - fill1 FILL
    + SOURCE DIST
    + PLACED ( 70000 70000 ) N ;
END COMPONENTS
PINS 3 ;
  - in + NET in
    + DIRECTION INPUT
    + LAYER met1 ( 0 0 ) ( 4000 10000 )
    + PLACED ( 0 45000 ) N ;
  - out + NET out
    + DIRECTION OUTPUT
    + LAYER met1 ( 0 0 ) ( 4000 10000 )
    + PLACED ( 96000 45000 ) N ;
  - vdd + NET vdd
    + DIRECTION INOUT
    + USE POWER
    + LAYER met2 ( 0 0 ) ( 10000 100000 )
    + PLACED ( 45000 0 ) N ;
END PINS
NETS 3 ;
  - in
    ( PIN in ) ( buf1 A ) ;
  - out
    ( PIN out ) ( buf1 Y ) ;
  - vdd
    ( PIN vdd ) ( buf1 VDD ) ;
END NETS
END DESIGN
